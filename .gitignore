# Credential files: match the shape, not a name someone happened to think of. A backup like
# accounts.json.bak or an override like .env.local must be ignored too, or a public repo leaks a key.
accounts*
!accounts.example.json
.env*
*.bak
*.save
data/
__pycache__/
.ruff_cache/
docs/plans/
docs/superpowers/
.cortexkit/
.superpowers/
*.db-*
